{% extends 'base.html.twig' %}

{% block title %}Suivi contrôleurs{% endblock %}

{% block body %}
    <div class="suivi-container">
        {% include 'suivi_activite/_year_filter.html.twig' %}
        {% include 'suivi_activite/_filters.html.twig' %}

        <div class="activite-infos">
            <p>Tous prix indiqués HT | Marge d'erreur CA < 1,5%</p>
        </div>

        <div class="centres-pros-wrapper">
            {% include 'suivi_activite/_controleurs_results.html.twig' %}

            <div class="filters-print-actions">
                <a href="{{ path('app_suivi_controleurs_print') }}"
                   data-print-keep-filters="1"
                   data-print-base-href="{{ path('app_suivi_controleurs_print') }}"
                   target="_blank"
                   rel="noopener"
                   class="btn-link">Imprimer</a>
            </div>
        </div>
    </div>
{% endblock %}
