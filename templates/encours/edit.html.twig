{% extends 'base.html.twig' %}

{% block title %}Modifier un encours{% endblock %}

{% block body %}
    <div class="form-wrapper">
        <small class="required-inputs">Les champs marqués d'un * sont obligatoires.</small><br><br>

        {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}

        {% include 'encours/_form.html.twig' with { form: form } %}

        {{ form_rest(form) }}

        <div class="filters-print-actions">
            <button type="submit" class="add">Enregistrer</button>
            <a href="{{ path('app_encours_bancaires') }}" class="btn-link">Retour</a>
        </div>
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}

