{% set fields = ['cb', 'especes', 'cheque', 'bl'] %}

<div class="stats-wrapper">
    <div class="stats-panel">
        <h2 class="releve-title">Produits</h2>

        <div class="releve-table-wrapper">
            <table class="releve-table">
                <thead>
                    <tr>
                        <th>Détail / Référence</th>
                        <th>CB</th>
                        <th>Esp.</th>
                        <th>Chq</th>
                        <th>BL</th>
                        <th>Total</th>
                        <th aria-label="Actions"></th>
                    </tr>
                </thead>

                <tbody
                    data-releve-collection
                    data-index="{{ form.relevesProduits|length }}"
                    data-prototype="{{ include(
                        'astikoto/stations/releve/_product_row.html.twig',
                        {row: form.relevesProduits.vars.prototype, totalCents: 0}
                    )|e('html_attr') }}"
                >
                    {% for row in form.relevesProduits %}
                        {% include 'astikoto/stations/releve/_product_row.html.twig' with {
                            row: row,
                            totalCents: attribute(releveTotals.productLines, loop.index0)
                        } only %}
                    {% endfor %}
                </tbody>

                <tfoot>
                    <tr class="calendar-total-row" data-section-total="produits">
                        <th>TOTAL</th>

                        {% for name in fields %}
                            <th data-total-field="{{ name }}">
                                {{ attribute(releveTotals.produits, name)|money }}
                            </th>
                        {% endfor %}

                        <th data-total-field="total">
                            {{ releveTotals.produits.total|money }}
                        </th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>

            <button
                type="button"
                class="btn-link releve-add-btn"
                data-add-releve-row
            >
                + Ajouter
            </button>
        </div>
    </div>
</div>
