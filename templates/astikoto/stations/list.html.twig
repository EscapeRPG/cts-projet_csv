{% extends 'base.html.twig' %}

{% block title %}Stations de lavage{% endblock %}

{% block body %}
    <div class="list-container">
        <div id="astikoto-stations-results" class="table-wrapper" data-list-results-container="1">
            <form id="stations-bulk-form"
                  method="post"
                  data-turbo="false"
                  action="{{ path('app_stations_bulk_update', {'q': app.request.query.get('q')}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('stations_bulk') }}">

                <table class="societes-list" data-bulk-edit="1">
                    <thead>
                    <tr>
                        <th>Société</th>
                        <th>Enseigne</th>
                        <th>Adresse</th>
                        <th>CP</th>
                        <th>Ville</th>
                        <th>Téléphone</th>
                        <th>Email</th>
                        <th>Site web</th>
                        <th>SIRET</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for station in stations %}
                        {% set rowId = station.id %}
                        <tr>
                            <td>
                                <select name="changes[{{ rowId }}][societe]" class="reseau-uppercase">
                                    <option value="">- Choisir -</option>
                                    {% for so in societes %}
                                        <option value="{{ so.id }}" {{ so.id == station.societe.id ? 'selected' : '' }}>
                                            {{ so.nom }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][reseauNom]" value="{{ station.reseauNom }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][coordonnees]" value="{{ station.coordonnees }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][cp]" value="{{ station.cp }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][ville]" value="{{ station.ville }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][telephone]" value="{{ station.telephone }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][email]" value="{{ station.email }}"></td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][siteWeb]" value="{{ station.siteWeb }}">
                            </td>
                            <td>
                                <input type="text" name="changes[{{ rowId }}][numSiret]" value="{{ station.numSiret }}">
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </form>

        </div>

        <div class="filters-print-actions">
            <button type="submit"
                    form="stations-bulk-form"
                    disabled
                    data-row-save-button="1"
                    data-bulk-save-button="1">
                Enregistrer
            </button>
        </div>
    </div>

    {% set errorsMessages = app.flashes('error') %}
    {% if errorsMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal error-modal" data-modals-target="modal">
                <h3>Erreurs détectées</h3>
                <ul>
                    {% for error in errorsMessages %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    {% set successMessages = app.flashes('success') %}
    {% if successMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal success-modal" data-modals-target="modal">
                <h2>Succès</h2>

                {% for message in successMessages %}
                    <p>{{ message }}</p>
                {% endfor %}

                <button id="close-modal" data-action="click->modals#hide">OK</button>
            </div>
        </div>
    {% endif %}

    {% set warningMessages = app.flashes('warning') %}
    {% if warningMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal error-modal" data-modals-target="modal">
                <h2>Attention</h2>

                {% for message in warningMessages %}
                    <p>{{ message }}</p>
                {% endfor %}

                <button id="close-modal" data-action="click->modals#hide">OK</button>
            </div>
        </div>
    {% endif %}
{% endblock %}
