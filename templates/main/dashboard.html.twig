{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN')
        or is_granted('ROLE_ORGANIGRAM_VIEW')
        or is_granted('ROLE_ENCOURS_VIEW')
        or is_granted('ROLE_LIST_SOCIETES_VIEW')
        or is_granted('ROLE_LIST_CENTRES_VIEW')
        or is_granted('ROLE_LIST_VOITURES_VIEW')
        or is_granted('ROLE_LIST_SALARIES_VIEW')
        or is_granted('ROLE_ASTIKOTO') %}
        <div class="entreprise">
            <img src="{{ asset('img/administration.png') }}" alt="administration">

            <div class="app-container">
                <fieldset class="app-category">
                    <legend>Listes</legend>

                    {% if is_granted('ROLE_ORGANIGRAM_VIEW') %}
                        <a href="{{ path('app_organigram') }}" class="app">
                            <img src="{{ asset('img/organigrammes.png') }}" alt="organigrammes structurels">
                            <div class="inner-div">Organigrammes</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ENCOURS_VIEW') %}
                        <a href="{{ path('app_encours_bancaires') }}" class="app">
                            <img src="{{ asset('img/encours.png') }}" alt="liste des encours bancaires">
                            <div class="inner-div">Encours</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_LIST_SOCIETES_VIEW') %}
                        <a href="{{ path('app_societes_list_uneditable') }}" class="app">
                            <img src="{{ asset('img/liste-societes.png') }}" alt="liste des sociétés">
                            <div class="inner-div">Sociétés</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_LIST_CENTRES_VIEW') %}
                        <a href="{{ path('app_centres_list_uneditable') }}" class="app">
                            <img src="{{ asset('img/liste-centres.png') }}" alt="liste des centres">
                            <div class="inner-div">Centres</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ASTIKOTO') %}
                        <a href="{{ path('app_stations_list_uneditable') }}" class="app">
                            <img src="{{ asset('img/liste-stations.png') }}" alt="liste des stations">
                            <div class="inner-div">Stations</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_LIST_VOITURES_VIEW') %}
                        <a href="{{ path('app_voitures_list_uneditable') }}" class="app">
                            <img src="{{ asset('img/liste-voitures.png') }}" alt="liste des voitures">
                            <div class="inner-div">Voitures</div>
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_LIST_SALARIES_VIEW') %}
                        <a href="{{ path('app_salaries_list_uneditable') }}" class="app">
                            <img src="{{ asset('img/liste-controleurs.png') }}" alt="liste des salariés">
                            <div class="inner-div">Salariés</div>
                        </a>
                    {% endif %}
                </fieldset>

                {% if is_granted('ROLE_ADMIN')
                    or is_granted('ROLE_ORGANIGRAM_ADD')
                    or is_granted('ROLE_ENCOURS_ADD')
                    or is_granted('ROLE_LIST_SOCIETES_ADD')
                    or is_granted('ROLE_LIST_CENTRES_ADD')
                    or is_granted('ROLE_LIST_VOITURES_ADD')
                    or is_granted('ROLE_LIST_SALARIES_ADD')
                    or is_granted('ROLE_ASTIKOTO') %}
                    <fieldset class="app-category">
                        <legend>Ajouts</legend>

                        {% if is_granted('ROLE_ENCOURS_ADD') %}
                            <a href="{{ path('app_encours_bancaires_add') }}" class="app">
                                <img src="{{ asset('img/ajout-encours.png') }}" alt="ajout d'encours bancaires">
                                <div class="inner-div">+ Encours</div>
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_LIST_SOCIETES_ADD') %}
                            <a href="{{ path('app_societes_add') }}" class="app">
                                <img src="{{ asset('img/ajout-societe.png') }}" alt="ajout de société">
                                <div class="inner-div">+ Société</div>
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_LIST_CENTRES_ADD') %}
                            <a href="{{ path('app_centres_add') }}" class="app">
                                <img src="{{ asset('img/ajout-centre.png') }}" alt="ajout de centre">
                                <div class="inner-div">+ Centre</div>
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_ASTIKOTO') %}
                            <a href="{{ path('app_stations_add') }}" class="app">
                                <img src="{{ asset('img/ajout-station.png') }}" alt="ajout de station">
                                <div class="inner-div">+ Station</div>
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_LIST_VOITURES_ADD') %}
                            <a href="{{ path('app_voitures_add') }}" class="app">
                                <img src="{{ asset('img/ajout-voiture.png') }}" alt="ajout de voiture">
                                <div class="inner-div">+ Voiture</div>
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_LIST_SALARIES_ADD') %}
                            <a href="{{ path('app_salaries_add') }}" class="app">
                                <img src="{{ asset('img/ajout-controleur.png') }}" alt="ajout de salarié">
                                <div class="inner-div">+ Salarié</div>
                            </a>
                        {% endif %}
                    </fieldset>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if is_granted('ROLE_CTS') %}
        <div class="entreprise">
            <img src="{{ asset('img/logo-cts.png') }}" alt="cts">

            <fieldset class="app-category">
                <a href="{{ path('app_suivi_activite') }}" class="app">
                    <img src="{{ asset('img/stats-activite.png') }}" alt="suivi activité">
                    <div class="inner-div">Activité</div>
                </a>

                <a href="{{ path('app_suivi_centres') }}" class="app">
                    <img src="{{ asset('img/stats-centres.png') }}" alt="suivi centres">
                    <div class="inner-div">Tous les centres</div>
                </a>

                <a href="{{ path('app_suivi_centre_details') }}" class="app">
                    <img src="{{ asset('img/details-centres.png') }}" alt="détails centre">
                    <div class="inner-div">Détails par centre</div>
                </a>

                <a href="{{ path('app_suivi_focus_pro') }}" class="app">
                    <img src="{{ asset('img/stats-pros.png') }}" alt="suivi clients professionnels">
                    <div class="inner-div">Professionnels</div>
                </a>

                <a href="{{ path('app_suivi_controleurs') }}" class="app">
                    <img src="{{ asset('img/stats-controleurs.png') }}" alt="suivi contrôleurs">
                    <div class="inner-div">Contrôleurs</div>
                </a>

                <a href="{{ path('app_suivi_modes_reglement') }}" class="app">
                    <img src="{{ asset('img/modes_reglement.png') }}" alt="modes règlement">
                    <div class="inner-div">Modes règlement</div>
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_first_results') }}" class="app">
                        <img src="{{ asset('img/dates-donnees.png') }}" alt="dates des premières données">
                        <div class="inner-div">Dates données</div>
                    </a>
                {% endif %}
            </fieldset>
        </div>
    {% endif %}

    {% if is_granted('ROLE_ASTIKOTO') %}
        <div class="entreprise">
            <img src="{{ asset('img/logo-astikoto.png') }}" alt="astikoto">

            <div class="app-container">
                <fieldset class="app-category">
                    <a href="{{ path('app_station_releves') }}" class="app">
                        <img src="{{ asset('img/dates-donnees.png') }}" alt="relevés journaliers">
                        <div class="inner-div">Relevés</div>
                    </a>

                    <a href="{{ path('app_station_details_entry') }}" class="app">
                        <img src="{{ asset('img/details-station.png') }}" alt="détails par station">
                        <div class="inner-div">Détails par station</div>
                    </a>

                    <a href="{{ path('astikoto_import_csv') }}" class="app">
                        <img src="{{ asset('img/import.png') }}" alt="import de fichiers">
                        <div class="inner-div">Import de fichiers</div>
                    </a>
                </fieldset>
            </div>
        </div>
    {% endif %}
{% endblock %}
