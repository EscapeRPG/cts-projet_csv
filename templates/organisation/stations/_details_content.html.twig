<div class="pro-stats-container" style="max-height: unset">
                {% if selectedStation == null %}
                    <div class="centre-detail-alert">
                        <p>Veuillez sélectionner une station pour consulter les détails.</p>
                    </div>
                {% else %}
                    <div class="pro-stats-panel">
                        <div class="stats-wrapper">
                            <h2>Informations</h2>

                            <table>
                                <tr>
                                    <td>Société</td>
                                    <td>{{ selectedStation.societe.nom }}</td>
                                </tr>
                                <tr>
                                    <td>Réseau</td>
                                    <td>{{ selectedStation.reseau.nom }}</td>
                                </tr>
                                <tr>
                                    <td>Enseigne</td>
                                    <td>{{ selectedStation.reseauNom }}</td>
                                </tr>
                                <tr>
                                    <td>Adresse</td>
                                    <td>{{ selectedStation.coordonnees ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <td>Code postal</td>
                                    <td>{{ selectedStation.cp }}</td>
                                </tr>
                                <tr>
                                    <td>Ville</td>
                                    <td>{{ selectedStation.ville }}</td>
                                </tr>
                                <tr>
                                    <td>Numéro de téléphone</td>
                                    <td>{{ selectedStation.telephone ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <td>Adresse email</td>
                                    <td>{{ selectedStation.email ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <td>Site web</td>
                                    <td>{{ selectedStation.siteWeb ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <td>SIRET</td>
                                    <td>{{ selectedStation.numSiret ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <td>Date de reprise</td>
                                    <td>{{ selectedStation.dateReprise ?? '—' }}</td>
                                </tr>
                            </table>
                        </div>

                        <div class="summary">
                            {% include 'releve_lavage/_annual_revenue_summary.html.twig' with { annualRevenues: annualRevenues, annualRevenueBreakdown: annualRevenueBreakdown } only %}
                            {% include 'releve_lavage/_annual_revenue_chart.html.twig' with { annualRevenues: annualRevenues } only %}
                        </div>

                        <div class="stats-wrapper graphique"
                             data-panel-focus-target="1"
                             data-pro-charts='{{ proCharts|json_encode|e('html_attr') }}'>
                            <div class="chart-canvas-wrap">
                                <canvas class="pro-chart-canvas"
                                        aria-label="Comparatif {{ referenceYear - 2 }} à {{ referenceYear }}"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="pro-stats-panel">
                        <div class="stats-wrapper">
                            <h2>Portiques</h2>

                            {% for equipement in selectedStation.equipementsStation %}
                                <ul>
                                    {% if equipement.categorie.value == "portique" %}
                                        <li>{{ equipement.libelle }}</li>
                                    {% endif %}
                                </ul>
                            {% endfor %}
                        </div>

                        <div class="stats-wrapper">
                            <h2>Bornes</h2>

                            {% for equipement in selectedStation.equipementsStation %}
                                <ul>
                                    {% if equipement.categorie.value == "borne" %}
                                        <li>{{ equipement.libelle }}</li>
                                    {% endif %}
                                </ul>
                            {% endfor %}
                        </div>

                        <div class="stats-wrapper">
                            <h2>Autres</h2>

                            {% for equipement in selectedStation.equipementsStation %}
                                <ul>
                                    {% if equipement.categorie.value == "autre" %}
                                        <li>{{ equipement.libelle }}</li>
                                    {% endif %}
                                </ul>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
