{% extends 'base.html.twig' %}

{% block title %}Détails de la station{% endblock %}

{% block body %}
    <div class="suivi-container">
        <div class="sidenav">
            <form method="get"
                  class="filter-form"
                  data-station-selector
            >
                <div class="filters-container">
                    <div class="filter-dropdown">
                        <button type="button" class="dropdown-toggle">
                            Stations
                        </button>

                        <div class="dropdown-menu" data-filter-list="station" data-filter-input-type="radio">
                            {% for availableStation in stations %}
                                <label>
                                    <input type="radio" name="station" value="{{ availableStation.id }}"
                                           data-station-url="{{ path('app_station_details', { id: availableStation.id }) }}"
                                        {{ availableStation.id == selectedStation.id ? 'checked' : '' }}>
                                    {{ availableStation.ville }}
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="activite-infos">
            <h2>Détails de la station de {{ selectedStation.ville }}</h2>
        </div>

        <div class="centres-pros-wrapper">
            {% include 'organisation/stations/_details_content.html.twig' %}

            <div class="filters-print-actions">
                <a href="{{ path('app_station_details_print', { id: station.id }) }}"
                   class="btn-link" target="_blank" rel="noopener">Imprimer</a>
                {% if is_granted('ROLE_ASTIKOTO') %}
                    <a href="{{ path('app_station_edit', { id: station.id }) }}" class="btn-link edit">Modifier</a>
                {% endif %}
            </div>
        </div>


    </div>

    {% set errorsMessages = app.flashes('error') %}
    {% if errorsMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal error-modal" data-modals-target="modal">
                <h3>Erreurs détectées</h3>
                <ul>
                    {% for error in errorsMessages %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    {% set successMessages = app.flashes('success') %}
    {% if successMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal success-modal" data-modals-target="modal">
                <h2>Succès</h2>

                {% for message in successMessages %}
                    <p>{{ message }}</p>
                {% endfor %}

                <button id="close-modal" data-action="click->modals#hide">OK</button>
            </div>
        </div>
    {% endif %}

    {% set warningMessages = app.flashes('warning') %}
    {% if warningMessages is not empty %}
        <div id="modal" class="modal-overlay" data-controller="modals" data-modals-target="overlay">
            <div class="modal error-modal" data-modals-target="modal">
                <h2>Attention</h2>

                {% for message in warningMessages %}
                    <p>{{ message }}</p>
                {% endfor %}

                <button id="close-modal" data-action="click->modals#hide">OK</button>
            </div>
        </div>
    {% endif %}
{% endblock %}
