<div class="pro-stats-panel">
    <div class="summary releve-summary-panel">
        <div class="ca-summary">
            <span class="panel-tools-title">CA du jour</span>
            <strong data-ca-day>{{ releveTotals.caJourCents|money }}</strong>
            <span class="panel-tools-title">Cumul HT</span>
            <strong data-ca-day-ht>{{ (releveTotals.caJourCents / 1.2)|money }}</strong>
        </div>
    </div>

    <div class="summary releve-summary-panel hoverable-summary">
        <div class="ca-summary">
            <span class="panel-tools-title">CA du mois</span>
            <strong>{{ monthlyRevenueCents|money }}</strong>

            <div class="previous">
                {% for comparison in monthlyComparisons %}
                    <div class="row">
                        <strong>{{ comparison.year }}</strong>
                        {{ comparison.revenueCents|money }}

                        {% if comparison.evolution is null %}
                            <div>—</div>
                        {% else %}
                            <div class="{{ comparison.evolution < 0 ? 'decreased' : 'increased' }}">
                                {{ comparison.evolution|number_format(2, ',', ' ') }} %
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="ca-summary hovered-summary">
            <span class="panel-tools-title">CA du mois</span>

            <div class="row">
                <span>Station</span>
                {{ monthlyRevenue.equipementsCents|money }}
            </div>

            <div class="row">
                <span>Produits</span>
                {{ monthlyRevenue.produitsCents|money }}
            </div>

            <div class="row">
                <span>Prestations</span>
                {{ monthlyRevenue.prestationsCents|money }}
            </div>
        </div>
    </div>

    {% include 'releve_lavage/_annual_revenue_summary.html.twig' with { annualRevenues: annualRevenues, annualRevenueBreakdown: annualRevenueBreakdown } only %}

    {{ form_widget(form.commentaire, {
        attr: {
            id: 'releve-commentaire',
            class: 'releve-commentaire-textarea',
            placeholder: 'Commentaires...'
        }
    }) }}
</div>
